{
  "mcpServers": {
    "zotero_local": {
      "cwd": ".",
      "command": "./bin/Zotero-ChatGPT-MCP.exe",
      "enabled": true,
      "default_tools_approval_mode": "approve",
      "tools": {
        "zotero_write_tag_with_confirmation": {
          "approval_mode": "prompt"
